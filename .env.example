# ==========================================================
# ServisYuk Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan nilainya
# ==========================================================

APP_ENV=local
APP_DEBUG=true
APP_NAME="ServisYuk - Jasa Perbaikan Rumah Tangga Berbasis AI"
APP_URL=http://localhost/jasa

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_jasa_perbaikan
DB_USERNAME=root
DB_PASSWORD=

# Multi-Provider AI Configuration
# Pilih provider: groq, gemini, nvidia, openai, atau custom
AI_CHATBOT_PROVIDER=groq
AI_CHATBOT_MODEL=qwen/qwen3.8-27b
AI_CHATBOT_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_OFFLINE_FALLBACK=true

# WhatsApp Gateway (Fonnte API)
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_TIMEOUT=15
FONNTE_COUNTRY_CODE=62
